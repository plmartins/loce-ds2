{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "paths": {
            "react": ["../node_modules/@types/react"],
            "react/*": ["../node_modules/@types/react/*"],
            "react-dom": ["../node_modules/@types/react-dom"],
            "react-dom/*": ["../node_modules/@types/react-dom/*"],
            "loce-ds2": ["../src/index.ts"],
            "loce-ds2/icons": ["../src/icons/index.ts"]
        }
    },
    "include": ["src", "vite.config.ts"]
}
